generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id             Int       @id @default(autoincrement())
  roomCode       Int       @unique
  roomName       String
  password       String?
  isPrivate      Boolean   @default(false)
  adminTokenHash String
  lastActivity   DateTime  @default(now())
  createdAt      DateTime  @default(now())
}